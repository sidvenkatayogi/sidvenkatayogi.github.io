{
	admin unix//run/s9v10-web/admin.sock
	servers {
		protocols h1 h2
	}
}

sh.s9v10.dev {
	root * /srv/s9v10-web
	@home path /
	header @home Cache-Control "no-cache"
	# Only the public page and its assets are served; no directory listings.
	@landing {
		method GET HEAD
		path / /assets/css/terminal.css /assets/js/terminal.js /assets/fonts/Inter_28pt-Regular.woff2 /assets/fonts/Inter-SemiBold.woff2
	}
	handle @landing {
		file_server
	}

	handle {
		respond "Not found" 404
	}
}
